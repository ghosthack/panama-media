<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ghosthack</groupId>
    <artifactId>panama-media-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>panama-media</name>
    <description>
        Direct Panama FFM (Java 26) bindings to native media libraries.
        These modules are thin Java wrappers around native C APIs, not frameworks:
        no ImageIO layer, no BufferedImage, and no java.desktop dependency.
        Image modules return raw MemorySegment-backed pixel data plus metadata,
        and consumers choose their own integration and memory lifetime.
    </description>
    <url>https://github.com/ghosthack/panama-media</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ghosthack</id>
            <name>ghosthack</name>
            <url>https://github.com/ghosthack</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/ghosthack/panama-media.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ghosthack/panama-media.git</developerConnection>
        <url>https://github.com/ghosthack/panama-media</url>
    </scm>

    <modules>
        <module>io.github.ghosthack.panama.media.core</module>
        <module>io.github.ghosthack.panama.media.comruntime</module>
        <module>io.github.ghosthack.panama.media.wic</module>
        <module>io.github.ghosthack.panama.media.mediafoundation</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java release shared by every panama-media module. -->
        <java.release>26</java.release>
        <maven.compiler.release>${java.release}</maven.compiler.release>
        <junit.version>5.12.1</junit.version>
        <test.native.access.modules>${module.name},io.github.ghosthack.panama.media.core${test.native.access.modules.extra}</test.native.access.modules>
        <test.native.access.modules.extra></test.native.access.modules.extra>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${java.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                    <configuration>
                        <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                        <argLine>
                            --enable-native-access=${test.native.access.modules}
                        </argLine>
                        <systemPropertyVariables>
                            <java.io.tmpdir>${project.build.directory}/tmp</java.io.tmpdir>
                        </systemPropertyVariables>
                        <environmentVariables>
                            <TMPDIR>${project.build.directory}/tmp</TMPDIR>
                            <TMP>${project.build.directory}/tmp</TMP>
                            <TEMP>${project.build.directory}/tmp</TEMP>
                        </environmentVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <doclint>all,-missing</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.11.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>create-shared-test-tmpdir</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/tmp"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.io.tmpdir>${project.build.directory}/tmp</java.io.tmpdir>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <TMPDIR>${project.build.directory}/tmp</TMPDIR>
                        <TMP>${project.build.directory}/tmp</TMP>
                        <TEMP>${project.build.directory}/tmp</TEMP>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Activate with: mvn -Prelease deploy -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
